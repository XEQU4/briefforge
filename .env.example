# Copy to .env.local and pass it with --env-file only when you need overrides.
FRONTEND_PORT=8080
# Authentication session settings. Set SESSION_COOKIE_SECURE=true behind HTTPS in production.
SESSION_COOKIE_NAME=briefforge_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
# Local Compose PostgreSQL defaults only. Replace these outside local development.
POSTGRES_DB=briefforge
POSTGRES_USER=briefforge
POSTGRES_PASSWORD=briefforge_local_dev
# Leave empty for the labelled rule-based ML fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
